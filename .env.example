# Local development settings. Copy to .env and fill in. Never commit .env.
# Production values live in AWS SSM Parameter Store (see deploy/.env.example).

# --- Django backend ---------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Path of the admin panel. Change it in production, e.g. manage-7f3k/
DJANGO_ADMIN_URL=admin/
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_CACHE_SECONDS=300
# Requests per visitor to the public API
API_ANON_THROTTLE=120/min
DJANGO_LOG_LEVEL=INFO

# Only used when DJANGO_DEBUG=0. Leave the redirect off behind a proxy that
# already sends HTTP to HTTPS (Caddy in production).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

# Local Postgres (Docker Compose). In production DATABASE_URL points at RDS.
POSTGRES_PASSWORD=portfolio-local-only
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Load the CV content when the container starts (local only).
SEED_ON_START=1

# --- FastAPI analytics service -----------------------------------------------
# Long random value used to anonymise visitors. Generate like DJANGO_SECRET_KEY.
ANALYTICS_SECRET_KEY=
ANALYTICS_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true only behind your own load balancer / reverse proxy.
ANALYTICS_TRUST_PROXY_HEADERS=false
ANALYTICS_CONTACT_RATE_LIMIT=5
ANALYTICS_EVENTS_RATE_LIMIT=60
# The /live dashboard: how long stats are cached, and how many days they cover.
ANALYTICS_STATS_CACHE_SECONDS=60
ANALYTICS_STATS_WINDOW_DAYS=30
# Fake-email checks: typos, throwaway inboxes and domains that can't receive mail.
# The DNS part switches itself off automatically if MX lookups don't work on the network.
ANALYTICS_EMAIL_DNS_CHECK=true
ANALYTICS_EMAIL_DNS_TIMEOUT=3.0
ANALYTICS_EMAIL_CHECK_RATE_LIMIT=30
# In production: postgresql+asyncpg://USER:PASSWORD@RDS-HOST:5432/DBNAME?ssl=require
# ANALYTICS_DATABASE_URL=

# Optional: email each new contact message through Amazon SES. Leave blank to
# only save messages (you can read them in the Django admin under Inbox).
ANALYTICS_CONTACT_NOTIFY_EMAIL=
ANALYTICS_SES_FROM_EMAIL=
ANALYTICS_AWS_REGION=eu-west-2
