# Copy to .env and fill in. Never commit .env.

# --- Django backend ---------------------------------------------------------
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Path of the admin panel. Change it in production, e.g. manage-7f3k/
DJANGO_ADMIN_URL=admin/
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_CACHE_SECONDS=300

# Local Postgres (Docker Compose). In production DATABASE_URL points at RDS.
POSTGRES_PASSWORD=portfolio-local-only
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Load the CV content when the container starts (local only).
SEED_ON_START=1
