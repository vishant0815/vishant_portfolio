# Production settings: reference only. Real values are stored in AWS SSM Parameter Store
# (eu-west-2) under /portfolio/prod/<group>/<NAME>; deploy.sh writes them into
# .env, backend.env and analytics.env on the server. Never put real values here.
# Secrets marked (secret) are SecureString parameters.

# --- /portfolio/prod/compose/ -> .env (read by Docker Compose itself) ----------
SITE_DOMAIN=example.com
ACME_EMAIL=you@example.com
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.eu-west-2.amazonaws.com
# IMAGE_TAG is added by deploy.sh (the git commit being deployed)

# --- /portfolio/prod/backend/ -> backend.env -------------------------------------
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=                                  # (secret)
DJANGO_ADMIN_URL=manage-xxxxxxxxxx/                 # (secret)
DJANGO_ALLOWED_HOSTS=api.example.com,backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=false                    # Caddy already redirects to HTTPS
API_CACHE_SECONDS=300
SEED_ON_START=0
DATABASE_URL=postgres://USER:PASSWORD@RDS-HOST:5432/portfolio?sslmode=require   # (secret)

# --- /portfolio/prod/analytics/ -> analytics.env ---------------------------------
ANALYTICS_SECRET_KEY=                               # (secret)
ANALYTICS_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS-HOST:5432/portfolio?ssl=require   # (secret)
ANALYTICS_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
ANALYTICS_TRUST_PROXY_HEADERS=true                  # behind Caddy
ANALYTICS_EMAIL_DNS_CHECK=true
